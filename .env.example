# ─────────────────────────────────────────────
# aspasia_bot — root .env.example
# Copy to .env and fill in values.
# Profile-specific examples: profiles/<n>/.env.example
# ─────────────────────────────────────────────

# Required
ANTHROPIC_API_KEY=sk-ant-api03-...

# Profile to load (bash_pt | aspasia_default | ...)
PROFILE=aspasia_default

# Model overrides (profile defaults are fine for most cases)
AGENT_MODEL=claude-3-5-sonnet-20241022
MAX_TOKENS=2048
TEMPERATURE=0.7
MEMORY_SIZE=50

# Web server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Telegram (only needed when profile has telegram_enabled=True)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Optional infra
REDIS_URL=
DATABASE_URL=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
