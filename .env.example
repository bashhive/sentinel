# ─────────────────────────────────────────────
# HiveSec Sentinel bot — root .env.example
# Copy to .env and fill in values.
# Profile-specific examples: profiles/<name>/.env.example
# ─────────────────────────────────────────────

# LLM provider — free-tier first, no paid API cost.
#   groq (default) | gemini | openrouter | local | anthropic
LLM_PROVIDER=groq

# Required for the OpenAI-compatible path (Groq free tier: https://console.groq.com)
GROQ_API_KEY=gsk_...
# Generic alias if you use another OpenAI-compatible provider:
# LLM_API_KEY=
# Optional endpoint override (e.g. Gemini OpenAI-compat / OpenRouter / local server):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Only needed if LLM_PROVIDER=anthropic (paid, optional)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Profile to load (bash_pt | hivesec_default | ...)
PROFILE=bash_pt

# Model overrides (profile defaults are fine for most cases)
AGENT_MODEL=llama-3.3-70b-versatile
PROBE_MODEL=llama-3.1-8b-instant
MAX_TOKENS=1024
TEMPERATURE=0.5
MEMORY_SIZE=30

# Web server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Telegram (only needed when profile has telegram_enabled=True) — @hivesecsentinelbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Optional infra
REDIS_URL=
DATABASE_URL=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
