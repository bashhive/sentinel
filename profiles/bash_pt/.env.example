# bash_pt — environment variables for Vercel deployment (HiveSec Sentinel)
# Free-tier LLM (no paid API cost). Get a key at https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
AGENT_MODEL=llama-3.3-70b-versatile
PROBE_MODEL=llama-3.1-8b-instant
# Optional: use another OpenAI-compatible provider instead of Groq
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

MAX_TOKENS=1024
TEMPERATURE=0.5
MEMORY_SIZE=30
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production
PROFILE=bash_pt

# Telegram not used by this profile — leave blank
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
